# ============================================================
# 轻营 · 环境变量模板
# 用法：复制本文件为 .env 并填写真实值。.env 已被 .gitignore 忽略，不会提交。
# ============================================================

# ---------- Nacos（docker-compose 使用） ----------
# Nacos JWT 鉴权密钥（base64 编码，解码后长度需 ≥ 32 字节）
# 生成方式：openssl rand -base64 48
NACOS_AUTH_TOKEN=请在此填写 base64 密钥
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=mySecureValue123

# Nacos 客户端账号（各服务 application.yml 默认 nacos/nacos，与服务端默认管理员一致；生产务必修改）
NACOS_USERNAME=nacos
NACOS_PASSWORD=请在此修改强密码

# ---------- 业务服务（启动时通过环境变量注入，覆盖 application.yml 默认值） ----------
# JWT 签名密钥（HS256 需 ≥ 32 字节）
#   · 容器编排：**必填**——docker-compose.business.yml 用 `${JWT_SECRET:?…}`，不设会直接拒绝启动；
#   · 本地 java -jar / IDEA：v0.11 起也会读本文件（common 的 dotenv 加载器），不设则退回 yml 内置开发值并打 ERROR 告警。
# 生成方式：openssl rand -hex 32
JWT_SECRET=请在此填写 ≥32 字节随机密钥

# auth 服务依赖 Redis：验证码存储 + 登录/发码分布式限流（docker-compose 暴露 6380）
REDIS_HOST=localhost
REDIS_PORT=6380

# 开发模式：auth 的 application.yml 本地默认已为 true（返回验证码明文，便于联调）；生产部署必须设为 false
DEV_CODE_ENABLED=false

# 链路追踪采样率（0~1，默认 1.0；traceId/spanId 输出到日志）
TRACING_SAMPLING_PROBABILITY=1.0

# 全链路追踪：**默认开启**（zipkin 容器随 docker compose up -d 一起启动，UI http://localhost:9411）。
# 不想上报（例如只跑基础设施、嫌日志有连接噪音）时设为 false。
# 注意：开关读的是 Nacos 共享配置 lingmart-common.yaml，改完要先 scripts/push-nacos-config.sh 推送。
ZIPKIN_ENABLED=true
# Zipkin 上报地址（可选，默认 http://localhost:9411/api/v2/spans）
# ZIPKIN_BASE_URL=http://localhost:9411/api/v2/spans

# 网关 OpenAPI 聚合对外地址（Apifox 导入后作为 Base URL）
GATEWAY_PUBLIC_ADDR=http://localhost:88

# ---------- 部署拓扑：Nacos 注册 IP ----------
# 场景 A（默认，无需取消注释）：业务服务跑在宿主机（IDEA / java -jar），基础设施跑容器
#   → 保持默认 127.0.0.1 即可（容器内组件经发布端口访问宿主机）
# 场景 B（必须填）：业务服务也用 docker-compose.business.yml 跑在容器内，或需局域网内其他机器访问
#   → 填宿主机当前局域网 IP；换网络/换机后必须同步更新，否则服务间 Feign 报「无实例」
#   → 同时把 BIND_ADDR 设为同一个 IP，否则业务容器之间的 Feign 会因端口只绑 127.0.0.1 而调不通
# NACOS_DISCOVERY_IP=请在此填写宿主机局域网IP
# BIND_ADDR=请与上面的 NACOS_DISCOVERY_IP 保持一致

# ---------- 业务服务端口绑定 ----------
# docker-compose.business.yml 里 8 个业务服务的宿主机绑定地址，默认 127.0.0.1：
# 只有本机能访问，局域网与 Docker 网关都到不了 /internal/**（这些接口没有鉴权）。
# 仅「场景 B」需要改成宿主机局域网 IP；生产请用 docker-compose.prod.yml（端口根本不发布）。
# BIND_ADDR=127.0.0.1

# ---------- Seata：客户端默认「直连 TC」，通常不需要配任何东西 ----------
# order/shop/ware 的 seata.registry.type 默认 file，TC 地址取 SEATA_GROUPLIST：
#   服务跑宿主机 → 127.0.0.1:8091（走容器端口映射，默认值）
#   服务跑容器   → docker-compose.business.yml 已覆盖为 seata-server:8091，无需你填
# 这样就不依赖「TC 往 Nacos 注册成什么 IP」——否则 TC 在容器里会注册成 Docker 内网 IP（172.x），
# 宿主机服务连不上，报 register RM failed: can not connect to services-server。
# 只有当你想切回 Nacos 注册方式时才需要下面两行（SEATA_IP 必须是真实 IPv4，填域名无效）：
# SEATA_REGISTRY_TYPE=nacos
# SEATA_IP=请在此填写宿主机局域网IP

# ---------- lingmart-agent（网页浮窗 Agent） ----------
# LLM 两把 Key（云上模型，无需本地 GPU）：
#  ① 对话 = DeepSeek（api.deepseek.com，deepseek-chat，支持 Function Calling）
#  ② 嵌入 = 阿里云百炼 DashScope（text-embedding-v3）——DeepSeek 没有 embedding 接口，
#     知识库向量化必须由百炼等独立嵌入厂商提供。
# 控制台：DeepSeek https://platform.deepseek.com/ ；百炼 https://bailian.console.aliyun.com/
DEEPSEEK_API_KEY=在此填写DeepSeek-API-KEY(sk-开头)
DASHSCOPE_API_KEY=在此填写百炼-API-KEY(sk-开头)
# 以下均有默认值，通常无需改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-chat
# DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# 向量库 ChromaDB（docker-compose.yml 已含 chroma 服务；宿主对外 18000，容器内网固定 8000）
# 本地 java -jar 运行连 127.0.0.1:18000；容器编排内由 business compose 覆写为 http://chroma:8000
CHROMA_HOST=http://localhost
CHROMA_PORT=18000
# 知识库集合名
CHROMA_COLLECTION=lingmart_kb

# Agent 行为参数（有默认值，按需覆盖）
AGENT_MEMORY_TTL_HOURS=24
AGENT_MAX_MESSAGES=20
AGENT_MAX_CONTEXT_CHARS=30000  # 拼给模型的 历史+当前 字符预算，超出裁剪最旧（近似 token 上限）
AGENT_KB_ENABLED=true
AGENT_KB_REBUILD_ON_START=false
AGENT_KB_TOP_K=3
AGENT_KB_EMBED_BATCH_SIZE=10     # 单次嵌入请求最大输入条数：百炼 text-embedding-v3 硬上限 10，调大会 400
AGENT_RATE_PER_USER_MINUTE=10
# 运行控制（有默认值，按需覆盖）
AGENT_MAX_TOOL_ITERATIONS=20   # 单会话最多可执行页面操作次数（防无限确认）
# 操作审计日志（落 lingmart_agent.agent_audit_log，首次部署需先执行 sql/lingmart_agent.sql）
AGENT_AUDIT_ENABLED=true                 # 关闭则完全不写库（本地纯调试用）
AGENT_AUDIT_RETENTION_DAYS=30            # 保留天数，定时任务硬删除；<=0 表示不清理
AGENT_AUDIT_EXCERPT_CHARS=80             # 用户消息摘录长度；0 = 完全不记正文（最小化最严档）
# 只读工具（服务端自主循环，免用户确认）
AGENT_READONLY_ENABLED=true              # 关闭后模型看不到查询类工具，退化为纯问答+页面引导
AGENT_READONLY_MAX_CALLS_PER_TURN=5      # 单轮最多执行次数
AGENT_READONLY_TURN_BUDGET_MS=15000      # 单轮循环总时长预算（3 次连查≈7.5s + 最终作答）
AGENT_READONLY_MAX_CALLS_PER_SESSION=50  # 单会话累计上限（防被诱导连续查询形成爬取）
AGENT_READONLY_CACHE_TTL_SECONDS=30      # 结果会话内短缓存（缓存键含 userId，不会跨用户串数据）
AGENT_READONLY_MAX_RESULT_CHARS=1500     # 工具返回文本上限
AGENT_GATEWAY_BASE_URL=http://localhost:88   # 只读工具走网关调业务 API（容器编排覆盖为 http://lingmart-gateway:88）
AGENT_MAX_CONCURRENT=32        # SSE 最大并发（信号量，超出快速拒绝）
AGENT_TYPING_DELAY_MS=0        # 打字机间隔毫秒，0=实时无延迟
AGENT_LLM_TIMEOUT_MS=30000     # 单次 LLM 调用超时毫秒，超时友好降级
AGENT_KB_OVERLAP_CHARS=60      # 知识块字符级重叠（检索端会做重叠去重拼接，此项主要影响向量质量）
# 开店材料上传（v0.29）：文件存服务端并解码成文本，发送时只传 documentId，正文不进消息体/不进历史
AGENT_DOC_ENABLED=true                   # 关闭后 /api/agent/doc 直接拒绝
AGENT_DOC_MAX_FILE_SIZE=2MB              # 单文件上限，须与 spring.servlet.multipart.max-file-size 一致
AGENT_DOC_MAX_CHARS=8000                 # 抽取文本上限（既是存储上限，也是注入模型的量）
AGENT_DOC_MAX_ROWS=500                   # 表格类文件最多读取行数（超出停止解析）
AGENT_DOC_RATE_PER_MINUTE=5              # 每用户每分钟上传次数
# 四层约束策略（v0.30）：把"要不要受理、要不要继承先前对话"的判断从模型手里拿回外部机制
# ============ 监控（Prometheus + Grafana，随 docker compose up -d 启动） ============
# Grafana 管理员账号；生产务必改密码
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

AGENT_CONSTRAINT_ENABLED=true            # 总开关（关=回到纯提示词约束）
AGENT_PREROUTE_ENABLED=true              # 前置路由：命中元请求/越狱模式直接回文案，不调用模型
AGENT_RESET_ON_OVERRIDE=true             # 角色重置：命中"忽略之前的指令"类话术则推进上下文地平线
AGENT_ATTENTION_DIGEST=true              # 注意力锚定：每轮在用户消息末尾重复硬约束提要
# HTTP 客户端超时（TCP/HTTP 层主动掐断，配合 AGENT_LLM_TIMEOUT_MS 防“取消不了”的僵尸连接）
HTTP_CLIENT_CONNECT_TIMEOUT=5s
HTTP_CLIENT_READ_TIMEOUT=35s

# 【可选】本地 Ollama 备用 profile（仅当换用纯本地模型时才需要，本机跑不动可完全忽略）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
