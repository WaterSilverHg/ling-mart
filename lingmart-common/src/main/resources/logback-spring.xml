<?xml version="1.0" encoding="UTF-8"?>
<!--
  轻营 · 统一日志配置
  由 lingmart-common 提供，全部业务服务（含网关）复用：
  - 控制台可读格式 + 滚动文件（./logs/{服务名}.log，保留 7 天）；
  - UTF-8 编码；输出 %X{traceId:-} / %X{spanId:-}（由 Micrometer Tracing 写入 MDC；未启用时为空占位）。
  生产如需接入 ELK / Loki 等 JSON 采集，可在此按 <springProfile> 切换到 JSON 编码器。
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="lingmart"/>

    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 滚动文件：./logs/{服务名}.log，按天归档保留 7 天（服务工作目录下，本地排障/采集用） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>./logs/${appName}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>./logs/${appName}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
