# ============================================================
# 轻营前端 · 环境变量模板
# 复制为 .env.development（开发）或 .env.production（生产）并按需修改。
# Vite 加载优先级：.env.local > .env.[mode] > .env
# ============================================================

# HTTP API 网关地址（含 /api 前缀；request.js 回退地址为 http://localhost:88/api）
VITE_API_BASE_URL=http://localhost:88/api

# 聊天 WebSocket 网关地址（ChatView.vue 回退地址为 ws://<当前主机名>:88/ws）
VITE_WS_URL=ws://localhost:88/ws
